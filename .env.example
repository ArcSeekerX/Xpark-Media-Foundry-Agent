# Video Agent Studio - runtime config template.
# Copy to .env and fill in your own endpoint/key. Real env vars win.

VA_HOST=0.0.0.0
VA_PORT=5100
VA_COMFY_BASE=http://127.0.0.1:8188
# Qwen-Image 2.1 reference-image service (scripts/qwen_image_server.py)
VA_QWEN_IMAGE_URL=http://127.0.0.1:8601
VA_IMAGE_COUNT=4
VA_IMAGE_STEPS=20

# --- Chat skills ---
# Only these skills show up in the "/" autocomplete (comma separated).
# Set VA_SKILLS_ALLOW=all to expose every installed skill.
VA_SKILLS_ALLOW=hypit,hypit-comfyui-video,sound-director,feishu-doc-glass-video,color-expert,theme-factory,design-review,frontend-design,hallmark,impeccable-design-polish

# --- Feishu (lark-cli) integration ---
VA_FEISHU_ENABLED=1
# Default recipient for web-triggered jobs (open_id ou_xxx or chat_id oc_xxx)
VA_FEISHU_TARGET=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Dedicated pipeline chat polled by scripts/feishu_bridge.py
VA_FEISHU_CHAT=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Extra chats the bridge also polls (comma separated), e.g. the bot's P2P chat
VA_FEISHU_EXTRA_CHATS=

# --- opencode DM bridge (scripts/opencode_bridge.py) ---
# P2P chat routed to a general opencode agent (thinking trace + task execution)
VA_OPENCODE_CHAT=
VA_OPENCODE_BIN=/root/.opencode/bin/opencode
# Model with consistent thinking output (reasoning stream) for the DM agent
VA_OPENCODE_MODEL=opencode-go/glm-5.3
VA_OPENCODE_DIR=/root
VA_OPENCODE_TIMEOUT=1800
VA_LARK_CLI=/root/.nvm/versions/node/v26.4.0/bin/lark-cli

# OpenAI-compatible text model for the agent brain.
VA_TEXT_BASE=https://opencode.ai/zen/go/v1
VA_TEXT_MODEL=deepseek-v4.1-flash
VA_TEXT_API_KEY=sk-...
# Optional extra request headers, JSON object.
VA_TEXT_HEADERS={"User-Agent": "VideoAgent/1.0", "x-opencode-session": "va-your-session-id"}
